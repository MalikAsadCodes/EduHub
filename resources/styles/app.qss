/*
 * Edu Hub stylesheet template.
 * Double-brace colour placeholders (for example the "primary" token) are filled in
 * by Theme::styleSheet() for the current light or dark theme.
 * Sizes are in device-independent pixels, so they scale with Windows display scaling.
 */

/* ---------- Base ---------- */
QWidget#AppRoot,
QWidget#LoginRoot,
QStackedWidget#PageStack,
QWidget[page="true"],
QWidget#PageContent {
    background: {{background}};
}

QWidget#LoginForm {
    background: {{surface}};
}

QScrollArea {
    background: transparent;
    border: none;
}

QLabel {
    color: {{text}};
    background: transparent;
}

QLabel[role="muted"]       { color: {{textMuted}}; }
QLabel[role="hint"]        { color: {{textMuted}}; font-size: 12px; }
QLabel[role="sectionTitle"]{ font-size: 15px; font-weight: 600; }
QLabel[role="rowTitle"]    { font-size: 13px; font-weight: 600; }
QLabel[role="rowDetail"]   { font-size: 12px; color: {{textMuted}}; }
QLabel[role="emptyTitle"]  { font-size: 18px; font-weight: 700; }
QLabel[role="eyebrow"]     { color: {{accentText}}; font-size: 11px; font-weight: 700; }
QLabel[role="fieldLabel"]  { color: {{textMuted}}; font-size: 12px; font-weight: 600; }
QLabel[role="loginTitle"]  { font-size: 28px; font-weight: 700; }

QLabel[role="pill"] {
    background: {{accentSoft}};
    color: {{accentText}};
    border-radius: 11px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 700;
}
QLabel[role="pillDone"] {
    background: {{accentSoft}};
    color: {{accentText}};
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
}
QLabel[role="pillMuted"] {
    background: {{surfaceAlt}};
    color: {{textMuted}};
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
}

QLabel[role="previewNote"] {
    background: {{accentSoft}};
    color: {{accentText}};
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 12px;
}

/* ---------- Navigation rail ---------- */
QFrame#NavRail {
    background: {{railBackground}};
    border: none;
}
QLabel#RailBrandName {
    color: #FFFFFF;
    font-size: 17px;
    font-weight: 700;
}
QLabel#RailBrandTag {
    color: {{railText}};
    font-size: 11px;
}
QLabel#RailSection {
    color: {{railText}};
    font-size: 10px;
    font-weight: 700;
    padding: 6px 12px 4px 12px;
}
QFrame#RailDivider {
    background: {{railHover}};
    border: none;
}

QPushButton[nav="true"] {
    background: transparent;
    color: {{railText}};
    border: none;
    border-radius: 10px;
    padding: 9px 12px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}
QPushButton[nav="true"]:hover {
    background: {{railHover}};
    color: #FFFFFF;
}
QPushButton[nav="true"]:checked {
    background: {{railActiveBackground}};
    color: {{railActiveText}};
    font-weight: 600;
}
QPushButton[nav="true"][collapsed="true"] {
    text-align: center;
    padding: 9px 0px;
}
QPushButton[nav="true"]:focus {
    background: {{railHover}};
}

/* ---------- Header ---------- */
QFrame#HeaderBar {
    background: {{surface}};
    border: none;
    border-bottom: 1px solid {{border}};
}
QLabel#Breadcrumb {
    color: {{textMuted}};
    font-size: 12px;
}
QLabel#PageTitle {
    color: {{text}};
    font-size: 20px;
    font-weight: 700;
}
QFrame#TermChip {
    background: {{accentSoft}};
    border: none;
    border-radius: 14px;
}
QLabel#TermChipText {
    color: {{accentText}};
    font-size: 12px;
    font-weight: 600;
}
QLineEdit#GlobalSearch {
    background: {{surfaceAlt}};
    border: 1px solid {{surfaceAlt}};
    border-radius: 10px;
    padding: 7px 8px;
    font-size: 13px;
}
QLineEdit#GlobalSearch:focus {
    background: {{surface}};
    border: 1px solid {{primary}};
}
QToolButton[iconButton="true"] {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 7px;
}
QToolButton[iconButton="true"]:hover {
    background: {{surfaceAlt}};
}
QToolButton#Avatar {
    background: {{primary}};
    color: {{primaryText}};
    border: 2px solid {{accent}};
    border-radius: 19px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    font-size: 12px;
    font-weight: 700;
}
QToolButton#Avatar::menu-indicator {
    image: none;
    width: 0px;
}
QLabel#MenuName {
    font-size: 13px;
    font-weight: 600;
}

/* ---------- Cards ---------- */
QFrame[card="true"] {
    background: {{surface}};
    border: 1px solid {{border}};
    border-radius: 14px;
}
QFrame[card="true"] QLabel {
    border: none;
}
QLabel[role="statLabel"]   { color: {{textMuted}}; font-size: 12px; font-weight: 600; }
QLabel[role="statValue"]   { font-size: 26px; font-weight: 700; }
QLabel[role="statCaption"] { color: {{textMuted}}; font-size: 12px; }

QFrame#HeroCard {
    border: none;
    border-radius: 16px;
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #22447C, stop: 1 #0B1630);
}
QLabel[role="heroEyebrow"] { color: #F2D27A; font-size: 11px; font-weight: 700; }
QLabel[role="heroTitle"]   { color: #FFFFFF; font-size: 24px; font-weight: 700; }
QLabel[role="heroText"]    { color: #C8D2E5; font-size: 13px; }

/* ---------- Sign-in brand panel (fixed brand colours) ---------- */
QLabel[role="brandWordmark"]   { color: #FFFFFF; font-size: 22px; font-weight: 700; }
QLabel[role="brandHeadline"]   { color: #FFFFFF; font-size: 30px; font-weight: 700; }
QLabel[role="brandInstitution"]{ color: #F2D27A; font-size: 14px; font-weight: 600; }
QLabel[role="brandFeature"]    { color: #DCE4F2; font-size: 13px; }
QLabel[role="brandFooter"]     { color: #8D9BB7; font-size: 11px; }

/* ---------- Buttons ---------- */
QPushButton[variant="primary"] {
    background: {{primary}};
    color: {{primaryText}};
    border: none;
    border-radius: 10px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton[variant="primary"]:hover   { background: {{primaryHover}}; }
QPushButton[variant="primary"]:pressed { background: {{primary}}; }
QPushButton[variant="primary"]:focus   { border: 2px solid {{accent}}; }
QPushButton[variant="primary"]:disabled {
    background: {{border}};
    color: {{textMuted}};
}

QPushButton[variant="secondary"] {
    background: {{surface}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 10px;
    padding: 9px 16px;
    font-weight: 600;
}
QPushButton[variant="secondary"]:hover { background: {{surfaceAlt}}; }

/* ---------- Inputs ---------- */
QLineEdit {
    background: {{surface}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 10px;
    padding: 9px 10px;
    font-size: 13px;
    selection-background-color: {{primary}};
    selection-color: {{primaryText}};
}
QLineEdit:focus {
    border: 1px solid {{primary}};
}
QLineEdit:disabled {
    background: {{surfaceAlt}};
    color: {{textMuted}};
}

/* ---------- Toast ---------- */
QFrame#Toast {
    background: {{surface}};
    border: 1px solid {{border}};
    border-radius: 12px;
}
QFrame#Toast QLabel {
    color: {{text}};
    font-size: 13px;
}

/* ---------- Menus and tooltips ---------- */
QMenu {
    background: {{surface}};
    border: 1px solid {{border}};
    padding: 6px;
}
QMenu::item {
    color: {{text}};
    padding: 8px 20px 8px 12px;
    border-radius: 6px;
}
QMenu::item:selected { background: {{surfaceAlt}}; }
QMenu::item:disabled { color: {{textMuted}}; }
QMenu::icon { padding-left: 8px; }
QMenu::separator {
    height: 1px;
    background: {{border}};
    margin: 5px 4px;
}

QToolTip {
    background: {{toastBackground}};
    color: {{toastText}};
    border: none;
    padding: 6px 8px;
}

/* ---------- Scroll bars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: {{border}};
    border-radius: 3px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover { background: {{textMuted}}; }
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: {{border}};
    border-radius: 3px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover { background: {{textMuted}}; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

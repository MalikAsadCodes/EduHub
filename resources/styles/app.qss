/*
 * Edu Hub stylesheet template.
 * Double-brace colour placeholders (for example the "primary" token) are filled in
 * by Theme::styleSheet() for the current light or dark theme.
 * Sizes are in device-independent pixels, so they scale with Windows display scaling.
 *
 * Type: Inter for interface text, Lora for display headings, DejaVu Sans Mono for
 * small spaced labels and codes. Letter spacing and upper case for those labels are
 * set in code (UiHelpers styleEyebrow), because stylesheets cannot do either.
 */

/* ---------- Base ---------- */
QWidget#AppRoot,
QWidget#LoginRoot,
QStackedWidget#PageStack,
QWidget[page="true"],
QWidget#PageContent {
    background: {{background}};
}

QWidget#LoginForm {
    background: {{background}};
}

QScrollArea {
    background: transparent;
    border: none;
}

QLabel {
    color: {{text}};
    background: transparent;
}

QLabel[role="muted"]       { color: {{textMuted}}; }
QLabel[role="hint"]        { color: {{textMuted}}; font-size: 12px; }
QLabel[role="sectionTitle"]{ font-family: "Lora"; font-size: 18px; }
QLabel[role="rowTitle"]    { font-size: 13px; font-weight: 600; }
QLabel[role="rowDetail"]   { font-size: 12px; color: {{textMuted}}; }
QLabel[role="emptyTitle"]  { font-family: "Lora"; font-size: 24px; }
QLabel[role="eyebrow"],
QLabel[role="cardEyebrow"] {
    color: {{accentText}};
    font-family: "DejaVu Sans Mono";
    font-size: 10px;
}
QLabel[role="fieldLabel"]  { color: {{textMuted}}; font-size: 12px; font-weight: 600; }
QLabel[role="loginTitle"]  { font-family: "Lora"; font-size: 36px; }
QLabel[role="mono"] {
    font-family: "DejaVu Sans Mono";
    font-size: 12px;
}

QLabel[role="pill"] {
    background: transparent;
    color: {{accentText}};
    border: 1px solid {{accent}};
    border-radius: 11px;
    padding: 3px 11px;
    font-size: 11px;
    font-weight: 600;
}
QLabel[role="pillDone"] {
    background: {{accentSoft}};
    color: {{accentText}};
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}
QLabel[role="pillMuted"] {
    background: {{surfaceAlt}};
    color: {{textMuted}};
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[role="previewNote"] {
    background: {{accentSoft}};
    color: {{accentText}};
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 12px;
}

/* ---------- Navigation rail (ink in both themes) ---------- */
QFrame#NavRail {
    background: {{railBackground}};
    border: none;
}
QLabel#RailBrandName {
    color: #F4EFE3;
    font-family: "Lora";
    font-size: 20px;
}
QLabel#RailBrandTag {
    color: {{railText}};
    font-family: "DejaVu Sans Mono";
    font-size: 9px;
}
QLabel#RailSection {
    color: #7D7564;
    font-family: "DejaVu Sans Mono";
    font-size: 9px;
    padding: 8px 12px 4px 12px;
}
QFrame#RailDivider {
    background: {{railHover}};
    border: none;
}

QPushButton[nav="true"] {
    background: transparent;
    color: {{railText}};
    border: none;
    border-radius: 8px;
    padding: 9px 12px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}
QPushButton[nav="true"]:hover {
    background: {{railHover}};
    color: #F4EFE3;
}
QPushButton[nav="true"]:checked {
    background: {{railActiveBackground}};
    color: {{railActiveText}};
    font-weight: 600;
}
QPushButton[nav="true"][collapsed="true"] {
    text-align: center;
    padding: 9px 0px;
}
QPushButton[nav="true"]:focus {
    background: {{railHover}};
}

/* ---------- Header ---------- */
QFrame#HeaderBar {
    background: {{background}};
    border: none;
    border-bottom: 1px solid {{border}};
}
QLabel#Breadcrumb {
    color: {{accentText}};
    font-family: "DejaVu Sans Mono";
    font-size: 10px;
}
QLabel#PageTitle {
    color: {{text}};
    font-family: "Lora";
    font-size: 26px;
}
QFrame#TermChip {
    background: transparent;
    border: 1px solid {{accent}};
    border-radius: 12px;
}
QLabel#TermChipText {
    color: {{accentText}};
    font-size: 12px;
    font-weight: 600;
}
QLineEdit#GlobalSearch {
    background: {{surface}};
    border: 1px solid {{border}};
    border-radius: 17px;
    padding: 7px 10px;
    font-size: 13px;
}
QLineEdit#GlobalSearch:focus {
    border: 1px solid {{accent}};
}
QToolButton[iconButton="true"] {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 7px;
}
QToolButton[iconButton="true"]:hover {
    background: {{surfaceAlt}};
}
QToolButton#Avatar {
    background: {{primary}};
    color: {{primaryText}};
    border: 2px solid {{background}};
    border-radius: 19px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    font-size: 12px;
    font-weight: 700;
}
QToolButton#Avatar::menu-indicator {
    image: none;
    width: 0px;
}
QLabel#MenuName {
    font-size: 13px;
    font-weight: 600;
}

/* ---------- Cards ---------- */
QFrame[card="true"] {
    background: {{surface}};
    border: 1px solid {{border}};
    border-radius: 12px;
}
QFrame[card="true"] QLabel {
    border: none;
}
QLabel[role="statLabel"] {
    color: {{textMuted}};
    font-family: "DejaVu Sans Mono";
    font-size: 10px;
}
QLabel[role="statValue"]   { font-family: "Lora"; font-size: 32px; }
QLabel[role="statCaption"] { color: {{textMuted}}; font-size: 12px; }

/* The dashboard greeting: type does the work, no gradient. */
QFrame#HeroCard {
    background: {{surface}};
    border: 1px solid {{border}};
    border-radius: 12px;
}
QFrame#HeroDate {
    background: transparent;
    border: none;
    border-left: 1px solid {{border}};
}
QLabel[role="heroEyebrow"] {
    color: {{accentText}};
    font-family: "DejaVu Sans Mono";
    font-size: 10px;
}
QLabel[role="heroTitle"]   { color: {{text}}; font-family: "Lora"; font-size: 34px; }
QLabel[role="heroText"]    { color: {{textMuted}}; font-size: 13px; }
QLabel[role="heroDay"]     { color: {{accentText}}; font-family: "Lora"; font-size: 44px; }
QLabel[role="heroMonth"] {
    color: {{textMuted}};
    font-family: "DejaVu Sans Mono";
    font-size: 10px;
}

/* ---------- Sign-in brand panel (ink in both themes) ---------- */
QLabel[role="brandWordmark"]   { color: #F4EFE3; font-family: "Lora"; font-size: 22px; }
QLabel[role="brandHeadline"]   { color: #F4EFE3; font-family: "Lora"; font-size: 40px; }
QLabel[role="brandInstitution"]{ color: #E8C878; font-size: 14px; font-weight: 600; }
QLabel[role="brandFeature"]    { color: #CFC7B5; font-size: 13px; }
QLabel[role="brandFooter"] {
    color: #8A826F;
    font-family: "DejaVu Sans Mono";
    font-size: 10px;
}

/* ---------- Buttons ---------- */
QPushButton[variant="primary"] {
    background: {{primary}};
    color: {{primaryText}};
    border: none;
    border-radius: 16px;
    padding: 9px 20px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton[variant="primary"]:hover   { background: {{primaryHover}}; }
QPushButton[variant="primary"]:pressed { background: {{primary}}; }
QPushButton[variant="primary"]:focus   { border: 2px solid {{text}}; }
QPushButton[variant="primary"]:disabled {
    background: {{border}};
    color: {{textMuted}};
}

QPushButton[variant="secondary"] {
    background: transparent;
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 16px;
    padding: 8px 14px;
    font-weight: 600;
}
QPushButton[variant="secondary"]:hover { border-color: {{accent}}; color: {{accentText}}; }

/* ---------- Inputs ---------- */
QLineEdit {
    background: {{surface}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 8px;
    padding: 9px 10px;
    font-size: 13px;
    selection-background-color: {{primary}};
    selection-color: {{primaryText}};
}
QLineEdit:focus {
    border: 1px solid {{accent}};
}
QLineEdit:disabled {
    background: {{surfaceAlt}};
    color: {{textMuted}};
}

/* ---------- Toast ---------- */
QFrame#Toast {
    background: {{surface}};
    border: 1px solid {{border}};
    border-radius: 10px;
}
QFrame#Toast QLabel {
    color: {{text}};
    font-size: 13px;
}

/* ---------- Menus and tooltips ---------- */
QMenu {
    background: {{surface}};
    border: 1px solid {{border}};
    padding: 6px;
}
QMenu::item {
    color: {{text}};
    padding: 8px 20px 8px 12px;
    border-radius: 6px;
}
QMenu::item:selected { background: {{surfaceAlt}}; }
QMenu::item:disabled { color: {{textMuted}}; }
QMenu::icon { padding-left: 8px; }
QMenu::separator {
    height: 1px;
    background: {{border}};
    margin: 5px 4px;
}

QToolTip {
    background: {{toastBackground}};
    color: {{toastText}};
    border: none;
    padding: 6px 8px;
}

/* ---------- Scroll bars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: {{border}};
    border-radius: 3px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover { background: {{textMuted}}; }
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: {{border}};
    border-radius: 3px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover { background: {{textMuted}}; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ======================================================================
 * Shared list, drawer, form and dialog styles (M1 onwards)
 * ====================================================================== */

/* ---------- Avatar role accents ---------- */
QToolButton#Avatar[accent="teacher"] { background: {{roleTeacher}}; color: #10241F; }
QToolButton#Avatar[accent="student"] { background: {{roleStudent}}; color: #0F1A2B; }

/* ---------- Tables ---------- */
QFrame#TableCard {
    background: {{surface}};
}
QTableView#RecordTable, QTableView[sheet="true"] {
    background: {{surface}};
    alternate-background-color: {{surfaceAlt}};
    border: none;
    border-radius: 12px;
    color: {{text}};
    selection-background-color: {{accentSoft}};
    selection-color: {{text}};
    font-size: 13px;
    outline: 0;
}
QTableView#RecordTable::item, QTableView[sheet="true"]::item {
    padding: 0px 10px;
    border-bottom: 1px solid {{surfaceAlt}};
}
QTableView#RecordTable::item:selected {
    background: {{accentSoft}};
    color: {{text}};
}
QTableView#RecordTable::item:hover {
    background: {{surfaceAlt}};
}
QHeaderView {
    background: transparent;
    border: none;
}
QHeaderView::section {
    background: {{surface}};
    color: {{textMuted}};
    border: none;
    border-bottom: 1px solid {{border}};
    padding: 10px 10px;
    font-size: 11px;
    font-weight: 600;
}
QHeaderView::section:hover { color: {{text}}; }
QTableCornerButton::section { background: {{surface}}; border: none; }
QLabel[role="tableFooter"] {
    color: {{textMuted}};
    font-size: 12px;
    padding: 8px 14px;
    border-top: 1px solid {{border}};
}

/* ---------- Drawer ---------- */
QFrame#Drawer {
    background: {{surface}};
}
QFrame#DrawerHeader {
    background: transparent;
    border: none;
    border-bottom: 1px solid {{border}};
}
QWidget#DrawerBody, QScrollArea#DrawerScroll {
    background: {{surface}};
}
QLabel[role="drawerTitle"] { font-family: "Lora"; font-size: 21px; }

QLabel[role="errorBanner"] {
    background: {{surfaceAlt}};
    color: {{danger}};
    border: 1px solid {{danger}};
    border-radius: 8px;
    padding: 9px 12px;
    font-size: 12px;
}
QLabel[role="noticeBanner"] {
    background: {{accentSoft}};
    color: {{accentText}};
    border-radius: 8px;
    padding: 9px 12px;
    font-size: 12px;
}

/* ---------- Forms ---------- */
QLabel[role="formSection"] { font-family: "Lora"; font-size: 16px; }
QLabel[role="detailLabel"] { color: {{textMuted}}; font-size: 12px; }
QLabel[role="detailValue"] { font-size: 13px; }
QLabel[role="credentialValue"] {
    font-family: "DejaVu Sans Mono";
    font-size: 15px;
    font-weight: 700;
    color: {{text}};
}
QFrame#FormDivider { background: {{border}}; border: none; }
QFrame#CredentialBox {
    background: {{surfaceAlt}};
    border: 1px dashed {{accent}};
    border-radius: 10px;
}

QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QPlainTextEdit, QTextEdit {
    background: {{surface}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 13px;
    selection-background-color: {{primary}};
    selection-color: {{primaryText}};
}
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid {{accent}};
}
QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QDateEdit:disabled {
    background: {{surfaceAlt}};
    color: {{textMuted}};
}
QComboBox::drop-down, QDateEdit::drop-down {
    border: none;
    width: 26px;
}
QComboBox QAbstractItemView {
    background: {{surface}};
    color: {{text}};
    border: 1px solid {{border}};
    selection-background-color: {{accentSoft}};
    selection-color: {{text}};
    outline: 0;
    padding: 4px;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    border: none;
    width: 18px;
}
QCheckBox {
    color: {{text}};
    spacing: 8px;
    font-size: 13px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid {{border}};
    border-radius: 4px;
    background: {{surface}};
}
QCheckBox::indicator:checked {
    background: {{primary}};
    border: 1px solid {{primary}};
}
QListWidget {
    background: {{surface}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 10px;
    padding: 4px;
    outline: 0;
}
QListWidget::item { padding: 6px 8px; border-radius: 6px; }
QListWidget::item:selected { background: {{accentSoft}}; color: {{text}}; }
QListWidget::item:hover { background: {{surfaceAlt}}; }

/* ---------- More buttons ---------- */
QPushButton[variant="danger"] {
    background: transparent;
    color: {{danger}};
    border: 1px solid {{border}};
    border-radius: 16px;
    padding: 8px 14px;
    font-weight: 600;
}
QPushButton[variant="danger"]:hover { border-color: {{danger}}; }
QPushButton[variant="dangerSolid"] {
    background: {{danger}};
    color: #FFFFFF;
    border: none;
    border-radius: 16px;
    padding: 9px 20px;
    font-weight: 600;
}
QPushButton[variant="ghost"] {
    background: transparent;
    color: {{accentText}};
    border: none;
    border-radius: 8px;
    padding: 6px 10px;
    font-weight: 600;
}
QPushButton[variant="ghost"]:hover { background: {{surfaceAlt}}; }
QPushButton[variant="secondary"]:disabled,
QPushButton[variant="danger"]:disabled,
QPushButton[variant="ghost"]:disabled {
    color: {{textMuted}};
    background: transparent;
    border-color: {{surfaceAlt}};
}
QPushButton[variant="secondary"]:focus { border: 1px solid {{accent}}; }

/* ---------- Dialogs ---------- */
QDialog {
    background: {{surface}};
}
QLabel[role="dialogTitle"] { font-family: "Lora"; font-size: 21px; }
QLabel[role="dialogText"] { color: {{textMuted}}; font-size: 13px; }

/* ---------- Tabs (segmented control) ---------- */
QTabBar#Segmented {
    background: transparent;
}
QTabBar#Segmented::tab {
    background: transparent;
    color: {{textMuted}};
    border: 1px solid {{border}};
    padding: 7px 18px;
    margin-right: 6px;
    border-radius: 14px;
    font-size: 13px;
    font-weight: 600;
}
QTabBar#Segmented::tab:selected {
    background: {{primary}};
    color: {{primaryText}};
    border: 1px solid {{primary}};
}
QTabBar#Segmented::tab:hover:!selected {
    color: {{text}};
    border: 1px solid {{accent}};
}

/* ---------- Rail scrolling ---------- */
QScrollArea#RailScroll, QWidget#RailItems {
    background: transparent;
    border: none;
}
QScrollArea#RailScroll QScrollBar:vertical {
    width: 6px;
    margin: 0px;
}
QScrollArea#RailScroll QScrollBar::handle:vertical {
    background: {{railHover}};
}
